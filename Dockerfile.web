# ---- OppSignal web image: builds the SPA and serves it via Caddy ----
# Caddy also reverse-proxies /api/* to the api service, so web + api are same-origin
# (no CORS) and Caddy terminates TLS in production. Build context: repository root.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine AS final
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
# SITE_ADDRESS controls the site block: ":80" for local, or a domain for auto-HTTPS.
ENV SITE_ADDRESS=:80
EXPOSE 80
EXPOSE 443
