# ─────────────────────────────────────────────────────────────────────────────
# ContractCanary — production environment reference.
# Copy to `.env`, fill in the blanks, then: docker compose -f docker-compose.prod.yml up -d
# EVERY secret below is read from an env var by the code — paste and restart, no rebuild.
# See HUMAN_TODO.md for exactly where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Public URLs / TLS ----
# The domain Caddy serves + provisions TLS for (e.g. contract-canary.com).
SITE_ADDRESS=contract-canary.com
# Public base URL of the web app — used to build links in emails. Must match SITE_ADDRESS.
BRANDING_WEB_BASE_URL=https://contract-canary.com

# ---- Database (AWS RDS or any Postgres 16) ----
# Single connection string; production points at RDS.
CONNECTIONSTRINGS_POSTGRES=Host=your-rds-endpoint.rds.amazonaws.com;Port=5432;Database=oppsignal;Username=oppsignal;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# ---- Auth ----
# 32+ byte random string. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_to_a_long_random_secret_at_least_32_bytes

# ---- SAM.gov ingest ----
# "Fixture" (fake data, no key) or "Sam" (real API — requires the key below).
INGEST_SOURCE=Sam
SAM_API_KEY=
SAM_BASE_URL=https://api.sam.gov
INGEST_INTERVAL_MINUTES=180
INGEST_WINDOW_DAYS=3
DIGEST_SEND_HOUR_LOCAL=7

# ---- Email (Postmark) ----
EMAIL_PROVIDER=Postmark
EMAIL_FROM_EMAIL=digests@contract-canary.com
EMAIL_FROM_NAME=ContractCanary
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# ---- Stripe (test-mode until go-live) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=https://contract-canary.com/app/settings?checkout=success
STRIPE_CANCEL_URL=https://contract-canary.com/app/settings?checkout=cancel
STRIPE_PORTAL_RETURN_URL=https://contract-canary.com/app/settings

# ---- Branding (rename the product here + frontend/src/config/branding.ts) ----
BRANDING_PRODUCT_NAME=ContractCanary
BRANDING_TAGLINE=Never miss a federal contract again.
BRANDING_SUPPORT_EMAIL=support@contract-canary.com
BRANDING_COMPANY_LEGAL_NAME=Contract Canary

# ---- Seed ----
# Keep false in production (only the fixture demo seeds fake users/notices).
SEED_DEMO=false
