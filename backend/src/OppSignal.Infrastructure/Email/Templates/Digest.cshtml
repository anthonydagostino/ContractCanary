@model OppSignal.Application.Email.DigestModel
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Your @Model.ProductName digest</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9;padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;">
                    <!-- header -->
                    <tr>
                        <td style="background-color:@Model.BrandColor;padding:24px 28px;border-radius:12px 12px 0 0;">
                            <table role="presentation" width="100%">
                                <tr>
                                    <td>
                                        <span style="color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.02em;">@Model.ProductName</span>
                                    </td>
                                    <td align="right">
                                        <span style="color:rgba(255,255,255,0.85);font-size:13px;">@Model.DateLabel</span>
                                    </td>
                                </tr>
                            </table>
                            @if (Model.HasMatches)
                            {
                                <p style="margin:14px 0 0 0;color:#ffffff;font-size:20px;font-weight:700;line-height:1.3;">
                                    @Model.TotalCount new @(Model.TotalCount == 1 ? "opportunity" : "opportunities") match your profiles
                                </p>
                            }
                            else if (Model.HasAlerts)
                            {
                                <p style="margin:14px 0 0 0;color:#ffffff;font-size:20px;font-weight:700;line-height:1.3;">
                                    @Model.AlertCount @(Model.AlertCount == 1 ? "update" : "updates") on opportunities you're tracking
                                </p>
                            }
                            else
                            {
                                <p style="margin:14px 0 0 0;color:#ffffff;font-size:20px;font-weight:700;line-height:1.3;">
                                    @Model.ClosingSoonCount @(Model.ClosingSoonCount == 1 ? "opportunity" : "opportunities") you're tracking @(Model.ClosingSoonCount == 1 ? "is" : "are") closing soon
                                </p>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="background-color:#ffffff;padding:8px 20px 24px 20px;border-left:1px solid #e2e8f0;border-right:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;border-radius:0 0 12px 12px;">
                            @if (Model.HasClosingSoon)
                            {
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;">
                                    <tr>
                                        <td style="padding:0 8px 8px 8px;border-bottom:2px solid #fecaca;">
                                            <span style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#b91c1c;">Closing soon — don't miss the deadline</span>
                                            <span style="font-size:12px;color:#94a3b8;">&nbsp;·&nbsp;@Model.ClosingSoonCount</span>
                                        </td>
                                    </tr>
                                </table>

                                @foreach (var c in Model.ClosingSoon)
                                {
                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;background-color:#fef2f2;border:1px solid #fecaca;border-radius:10px;">
                                        <tr>
                                            <td style="padding:14px 18px;">
                                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px 0;">
                                                    <tr>
                                                        <td style="padding:3px 9px;background-color:#fee2e2;border-radius:6px;font-size:11px;font-weight:700;color:#991b1b;">@c.DaysLeftLabel</td>
                                                    </tr>
                                                </table>
                                                <a href="@c.DetailLink" style="font-size:15px;font-weight:600;color:#0f172a;text-decoration:none;line-height:1.4;">@c.Title</a>
                                                <p style="margin:6px 0 8px 0;font-size:13px;color:#475569;">@c.Agency</p>
                                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td style="font-size:12px;color:#64748b;padding:1px 0;width:110px;">Response due</td>
                                                        <td style="font-size:12px;color:#b91c1c;font-weight:600;padding:1px 0;">@c.DeadlineLabel</td>
                                                    </tr>
                                                </table>
                                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:12px;">
                                                    <tr>
                                                        <td style="border-radius:6px;background-color:@Model.BrandColor;">
                                                            <a href="@c.DetailLink" style="display:inline-block;padding:8px 16px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px;">View details</a>
                                                        </td>
                                                        <td style="width:8px;"></td>
                                                        <td style="border-radius:6px;border:1px solid #cbd5e1;">
                                                            <a href="@c.SamLink" style="display:inline-block;padding:8px 16px;font-size:13px;font-weight:600;color:#334155;text-decoration:none;border-radius:6px;">SAM.gov</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                }
                            }

                            @if (Model.HasAlerts)
                            {
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;">
                                    <tr>
                                        <td style="padding:0 8px 8px 8px;border-bottom:2px solid #fde68a;">
                                            <span style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#b45309;">Changes to opportunities you're tracking</span>
                                            <span style="font-size:12px;color:#94a3b8;">&nbsp;·&nbsp;@Model.AlertCount</span>
                                        </td>
                                    </tr>
                                </table>

                                @foreach (var alert in Model.Alerts)
                                {
                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;background-color:@(alert.IsCancelled ? "#fef2f2" : "#fffbeb");border:1px solid @(alert.IsCancelled ? "#fecaca" : "#fde68a");border-radius:10px;">
                                        <tr>
                                            <td style="padding:14px 18px;">
                                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px 0;">
                                                    <tr>
                                                        <td style="padding:3px 9px;background-color:@(alert.IsCancelled ? "#fee2e2" : "#fef3c7");border-radius:6px;font-size:11px;font-weight:700;color:@(alert.IsCancelled ? "#991b1b" : "#92400e");">@alert.TypeLabel</td>
                                                    </tr>
                                                </table>
                                                <p style="margin:0 0 4px 0;font-size:14px;font-weight:600;color:#0f172a;line-height:1.4;">@alert.Message</p>
                                                <a href="@alert.DetailLink" style="font-size:13px;color:#475569;text-decoration:none;">@alert.Title</a>
                                            </td>
                                        </tr>
                                    </table>
                                }
                            }

                            @foreach (var group in Model.Groups)
                            {
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;">
                                    <tr>
                                        <td style="padding:0 8px 8px 8px;border-bottom:2px solid #e2e8f0;">
                                            <span style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#475569;">@group.ProfileName</span>
                                            <span style="font-size:12px;color:#94a3b8;">&nbsp;·&nbsp;@group.Items.Count</span>
                                        </td>
                                    </tr>
                                </table>

                                @foreach (var item in group.Items)
                                {
                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;">
                                        <tr>
                                            <td style="padding:16px 18px;">
                                                <a href="@item.DetailLink" style="font-size:16px;font-weight:600;color:#0f172a;text-decoration:none;line-height:1.4;">@item.Title</a>
                                                <p style="margin:6px 0 10px 0;font-size:13px;color:#475569;">@item.Agency</p>

                                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 12px 0;">
                                                    <tr>
                                                        <td style="padding:3px 9px;background-color:#e0e7ff;border-radius:6px;font-size:11px;font-weight:600;color:#3730a3;">@item.TypeLabel</td>
                                                        @if (!string.IsNullOrWhiteSpace(item.SetAside))
                                                        {
                                                            <td style="width:6px;"></td>
                                                            <td style="padding:3px 9px;background-color:#dcfce7;border-radius:6px;font-size:11px;font-weight:600;color:#166534;">@item.SetAside</td>
                                                        }
                                                    </tr>
                                                </table>

                                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                                    @if (!string.IsNullOrWhiteSpace(item.Deadline))
                                                    {
                                                        <tr>
                                                            <td style="font-size:12px;color:#64748b;padding:1px 0;width:120px;">Response due</td>
                                                            <td style="font-size:12px;color:#b91c1c;font-weight:600;padding:1px 0;">@item.Deadline</td>
                                                        </tr>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.PlaceOfPerformance))
                                                    {
                                                        <tr>
                                                            <td style="font-size:12px;color:#64748b;padding:1px 0;">Place of perf.</td>
                                                            <td style="font-size:12px;color:#334155;padding:1px 0;">@item.PlaceOfPerformance</td>
                                                        </tr>
                                                    }
                                                </table>

                                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:12px;">
                                                    <tr>
                                                        <td style="border-radius:6px;background-color:@Model.BrandColor;">
                                                            <a href="@item.DetailLink" style="display:inline-block;padding:8px 16px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px;">View details</a>
                                                        </td>
                                                        <td style="width:8px;"></td>
                                                        <td style="border-radius:6px;border:1px solid #cbd5e1;">
                                                            <a href="@item.SamLink" style="display:inline-block;padding:8px 16px;font-size:13px;font-weight:600;color:#334155;text-decoration:none;border-radius:6px;">SAM.gov</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                }
                            }

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:24px;">
                                <tr>
                                    <td align="center" style="padding:8px;">
                                        <a href="@Model.DashboardUrl" style="font-size:14px;font-weight:600;color:@Model.BrandColor;text-decoration:none;">Open your dashboard →</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <!-- footer -->
                    <tr>
                        <td style="padding:20px 28px;">
                            <p style="margin:0;font-size:12px;color:#94a3b8;line-height:1.6;">
                                You’re receiving this daily opportunity digest because you signed up for @Model.ProductName.<br />
                                <a href="@Model.UnsubscribeUrl" style="color:#64748b;">Unsubscribe from the digest</a>
                                &nbsp;·&nbsp;
                                <a href="@Model.SettingsUrl" style="color:#64748b;">Manage settings</a>
                                &nbsp;·&nbsp;
                                <a href="mailto:@Model.SupportEmail" style="color:#64748b;">@Model.SupportEmail</a>
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyPostalAddress))
                                {
                                    <br />
                                    <span>@Model.ProductName · @Model.CompanyPostalAddress</span>
                                }
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
